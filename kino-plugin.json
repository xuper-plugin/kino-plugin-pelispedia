{
  "id": "pelispedia",
  "name": "Pelispedia",
  "version": "0.4.10",
  "apiVersion": 30,
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Películas y series en español latino, castellano o subtituladas de pelispedia.is: sección propia, géneros, búsqueda y varias opciones por título.",
  "author": "xuper-plugin",
  "homepage": "https://github.com/xuper-plugin/kino-plugin-pelispedia",
  "hosts": [
    "raw.githubusercontent.com",
    "pelispedia.is",
    "fastream.to",
    "embedwish.com",
    "hglink.to",
    "hlswish.com",
    "streamwish.com",
    "streamwish.to",
    "strwish.com",
    "wishembed.com",
    "filelions.com",
    "vibuxer.com",
    "vidhide.com",
    "vidhidepro.com",
    "vidhideplus.com",
    "vidhidefast.com",
    "callistanise.com",
    "dintezuvio.com",
    "minochinos.com",
    "filelions.to",
    "morencius.com"
  ],
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve",
    "download",
    "scopedSearch",
    "screen"
  ],
  "streamHosts": "any",
  "categories": [
    "movies",
    "series"
  ],
  "color": "#7C3AED",
  "section": {
    "label": "Pelispedia",
    "labelEn": "Pelispedia"
  },
  "theme": {
    "accent": "#8B5CF6",
    "onAccent": "#FFFFFF",
    "background": "#0E081A",
    "surface": "#1A1030",
    "highlight": "#C4B5FD"
  },
  "settings": [
    {
      "key": "audioSection",
      "type": "section",
      "label": "Idioma",
      "labelEn": "Language",
      "hint": "Cada título puede traer varios idiomas; Kino abre primero el que elijas y, si falla, los demás.",
      "hintEn": "A title may come in several languages; Kino opens the one you pick first and, if it fails, the others."
    },
    {
      "key": "audio",
      "type": "select",
      "label": "Idioma preferido",
      "labelEn": "Preferred language",
      "default": "lat",
      "options": [
        {
          "value": "lat",
          "label": "Latino",
          "labelEn": "Latino"
        },
        {
          "value": "cast",
          "label": "Castellano",
          "labelEn": "Castilian"
        },
        {
          "value": "sub",
          "label": "Subtitulado",
          "labelEn": "Subtitled"
        }
      ]
    },
    {
      "key": "info",
      "type": "status",
      "label": "Estado",
      "labelEn": "Status"
    },
    {
      "key": "clearCache",
      "type": "action",
      "label": "Vaciar caché",
      "labelEn": "Clear cache",
      "confirm": "¿Vaciar la caché de listas?",
      "confirmEn": "Clear the list cache?"
    }
  ],
  "telemetry": true,
  "browser": true,
  "screen": {
    "label": "Pelispedia",
    "labelEn": "Pelispedia",
    "icon": "movie",
    "menuOpens": "screen",
    "opensFrom": [
      "menu",
      "settings"
    ],
    "settingsButton": {
      "label": "Abrir Pelispedia",
      "labelEn": "Open Pelispedia"
    },
    "settingsIn": "both"
  },
  "consumes": {
    "resolver": {
      "repo": "xuper-plugin/kino-plugin-kino-resolver",
      "door": "resolver",
      "calls": [
        "resolve"
      ]
    }
  },
  "recommends": [
    "xuper-plugin/kino-plugin-kino-resolver"
  ],
  "provides": {
    "catalog": {
      "summary": "Titles this plugin finds, for the author's other plugins",
      "calls": {
        "search": {
          "in": {
            "q": "string",
            "type": "string?",
            "tmdb": "number?"
          },
          "out": "Item[]"
        },
        "episodes": {
          "in": {
            "ref": "string"
          },
          "out": "Episode[]"
        }
      },
      "types": {
        "Item": {
          "id": "string",
          "ref": "string",
          "title": "string",
          "kind": "string",
          "poster": "string?",
          "backdrop": "string?",
          "year": "string?",
          "overview": "string?",
          "tmdb": "number?"
        },
        "Episode": {
          "season": "number",
          "number": "number",
          "ref": "string",
          "title": "string?"
        }
      }
    }
  },
  "signature": {
    "authorKey": "6693946bd5c56196960959c4b9665fad5094374bcb85ddb282f8bf762c835263",
    "value": "a71a9b9f5dd5b1c2fb260c8ba6dd267c9e67b5a21705e118293dbe9b01691bfe02f962b8bd572c606b9cce9eb32f16d96ec15222f5292e3cfd98ed77b022d503"
  }
}
